{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoxCraft Studio",
  "version": "2.3.2",
  "identifier": "com.cakesweet.voxcraft",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VoxCraft Studio",
        "width": 1280,
        "height": 820,
        "minWidth": 860,
        "minHeight": 520,
        "backgroundColor": "#00000000",
        "decorations": false,
        "transparent": true,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "linux": {
      "deb": {
        "depends": ["libportaudio2", "pulseaudio-utils", "pkexec"]
      },
      "rpm": {
        "depends": ["portaudio", "pulseaudio-utils", "polkit"]
      }
    },
    "windows": {
      "nsis": {
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/CakeSweet/voxcraft/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "basicUi"
      }
    }
  }
}
